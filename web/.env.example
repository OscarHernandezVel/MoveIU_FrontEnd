# Server-side only: where the Python core service lives (Next rewrites /api/v1/* to it).
BACKEND_URL=http://127.0.0.1:8080
# Browser: WebSocket of the core service. Vercel cannot proxy WebSockets through rewrites, so point it at
# the core service directly (wss://...). Empty = no WebSocket, the app polls GET /api/v1/buses/active.
NEXT_PUBLIC_WS_URL=
# Open vector-tile style (MapLibre). OpenFreeMap has no guarantees: host your own style for production.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# Seconds between polls when the WebSocket is not available (3-5 in v7).
NEXT_PUBLIC_POLL_SECONDS=3
# Modo demostración (flota simulada con rutas reales de Pasto, sin servidor):
#   auto = datos reales y, si el servidor no responde, demostración (por omisión) · on = siempre · off = nunca.
# La dirección ?demo=1 o ?demo=0 lo fuerza en esa visita. La página /recorrido siempre usa la demostración.
NEXT_PUBLIC_DEMO=auto
